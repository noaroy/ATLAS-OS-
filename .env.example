# ─────────────────────────────────────────────────────────────
# ATLAS OS — environment configuration
# Copy to `.env` and adjust. Never commit the real `.env`.
# ─────────────────────────────────────────────────────────────

# --- Core ---------------------------------------------------
NODE_ENV=development
ATLAS_HOST=0.0.0.0
ATLAS_PORT=4700
# Public origin used for links in alerts / n8n callbacks
ATLAS_PUBLIC_URL=http://localhost:4700
# Comma-separated origins allowed to call the API from a browser.
ATLAS_CORS_ORIGINS=http://localhost:5173
# Où un outil local joint le serveur (atlas:status, contrôles). Vide : http://127.0.0.1:<port>,
# et http://atlas:<port> depuis le conteneur outils (ATLAS_CLI_CONTEXT=docker).
# ATLAS_INTERNAL_URL=
# Quels en-têtes X-Forwarded-* croire. false (défaut) : aucun — nul ne peut se dire 127.0.0.1
# par un en-tête. Derrière Caddy sur le réseau Compose : ATLAS_TRUST_PROXY=uniquelocal
# (ou le CIDR du proxy). Jamais un nombre de sauts.
ATLAS_TRUST_PROXY=false

# --- Security -----------------------------------------------
# 32+ random characters. Generate: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
ATLAS_SESSION_SECRET=change-me-to-a-long-random-value-please
# Founder account created on first boot.
ATLAS_FOUNDER_EMAIL=founder@atlas.local
ATLAS_FOUNDER_PASSWORD=change-me

# --- Storage ------------------------------------------------
ATLAS_DATA_DIR=./data
ATLAS_BACKUP_DIR=./data/backups
# La base est <ATLAS_DATA_DIR>/atlas.db. Sur le VPS, une seule base : /data/atlas.db
# dans le volume Docker, ouverte par le serveur ET par atlas-cli (deployment/atlas-cli.sh).
# Un script lancé depuis l'hôte du dépôt déployé refuse d'ouvrir ./data/atlas.db
# (garde de base canonique). Pour lire volontairement un autre fichier :
#   ATLAS_DB_PATH=/chemin/vers/une-copie.db   (absolu, ou relatif au dépôt)
#   ATLAS_ALLOW_HOST_DB=1                     (assume la base de l'hôte, en connaissance de cause)
#   ATLAS_CANONICAL_DB=docker                 (pose la garde même sans docker-compose.private.yml)
ATLAS_BACKUP_RETENTION=14

# --- Intelligence -------------------------------------------
# Leave ANTHROPIC_API_KEY empty to run in deterministic SIMULATION mode.
# The full system works offline in simulation; results are clearly labelled.
ANTHROPIC_API_KEY=

# Quel mode, explicitement : auto | simulation | live
#
# `auto` déduit le mode de la présence d'une clé. C'est pratique et c'est
# exactement ce qu'il ne faut pas en production : une clé posée pour un essai
# fait basculer tout le déploiement en facturé sans que personne ne l'ait décidé.
# Une déclaration explicite l'emporte toujours sur la déduction.
ATLAS_EXECUTION_MODE=auto

# Hermes plans and synthesises. Agents execute.
#
# Haiku des deux côtés : le travail réel est de l'extraction et du tri, où
# l'écart avec un modèle dix-huit fois plus cher ne se voit pas dans le
# résultat — seulement sur la facture. Montez Hermès à `claude-sonnet-5` si la
# planification déçoit, et mesurez avant de garder le changement.
ATLAS_HERMES_MODEL=claude-haiku-4-5-20251001
ATLAS_AGENT_MODEL=claude-haiku-4-5-20251001
ATLAS_LLM_EFFORT=high
ATLAS_LLM_MAX_TOKENS=16000

# Le verrou de modèle. Un plafond de dépense ne sert à rien si un modèle
# beaucoup plus cher peut être choisi trois lignes plus loin — et trois chemins
# y menaient : un réglage de console, une variable d'environnement, et le
# `model` propre à un agent. Le refus est appliqué sous les appels, dans le
# décorateur que tous traversent.
#
# Correspondance par préfixe : `claude-opus` attrape toutes ses versions.
ATLAS_FORBIDDEN_MODELS=claude-opus
# Vide = tout sauf les interdits. Renseigné, il devient exclusif : un modèle
# absent de la liste est refusé même si rien ne l'interdit nommément.
ATLAS_ALLOWED_MODELS=

# --- Orchestration ------------------------------------------
ATLAS_MAX_CONCURRENT_MISSIONS=3
ATLAS_MAX_CONCURRENT_TASKS=4
ATLAS_TASK_TIMEOUT_MS=300000
ATLAS_TASK_MAX_ATTEMPTS=3
# Default token ceiling per mission. A mission that reaches it stops cleanly,
# keeping the work already done. 0 = no ceiling.
ATLAS_MISSION_TOKEN_BUDGET=400000
# How many times Hermes may replan one mission after a step the plan depended
# on fails permanently. 0 disables replanning.
ATLAS_MAX_REPLANS_PER_MISSION=1

# ─── Plafonds économiques ────────────────────────────────────────────────────
# Vérifiés AVANT chaque appel au modèle, et non entre deux étapes. La nuance
# est ce qui sépare un plafond d'un constat : LIVE #001 avait un budget de
# 400 000 jetons et en a consommé 1 524 676, parce qu'une étape déjà lancée
# n'était plus contrôlée. Mettre 0 sur une ligne désactive ce plafond-là.

# Le seul plafond qui parle la langue de la facture. Un plafond en jetons
# dépend du modèle : router vers un modèle plus cher multiplierait la dépense
# sans faire bouger le compteur de jetons.
ATLAS_MAX_MISSION_COST_USD=5
# Plafond quotidien de dépense modèle, toutes missions confondues (USD). 0 = aucun plafond.
# Une mission client s'arrête proprement quand il est atteint ; les tests gratuits ne sont pas concernés.
ATLAS_AI_DAILY_BUDGET_USD=2.00

# Une seule étape ne doit jamais pouvoir absorber la mission entière.
# L'enrichissement de LIVE #001 a consommé 343 % du budget total.
# Le plafond effectif est le plus petit entre cette valeur et le tiers du
# budget de la mission.
ATLAS_MAX_STEP_TOKENS=120000

# Borne l'acharnement d'un agent : au-delà, l'étape est arrêtée.
ATLAS_MAX_LLM_CALLS_PER_STEP=12

# Une réponse non plafonnée est le seul poste de coût qu'on ne peut plus
# interrompre une fois l'appel parti.
ATLAS_MAX_OUTPUT_TOKENS_PER_CALL=16000

# Échecs consécutifs après lesquels ATLAS cesse d'appeler le modèle pour cette
# mission. Réessayer vingt fois un appel qui échoue toujours pareil coûte vingt
# fois et n'apprend rien.
ATLAS_CIRCUIT_BREAKER_FAILURES=3

# Sortie minimale sous laquelle un appel n'a plus de sens. Le budget adaptatif
# rétrécit la réponse pour tenir dans ce qui reste ; en dessous de ce seuil il
# refuse plutôt que de payer une réponse coupée en deux.
ATLAS_MIN_VIABLE_OUTPUT_TOKENS=512

# ─── Délais de garde ─────────────────────────────────────────────────────────
# Quatre niveaux emboîtés, chacun annulant réellement l'appel (AbortSignal) au
# lieu de l'abandonner. LIVE #002 n'en avait qu'un — l'étape — et il ne couvrait
# que l'inférence propre de l'agent : une recherche web est restée en vol
# 1 284 secondes sous un délai d'étape de 300, et la mission n'a jamais rendu
# la main.
# L'ordre est vérifié au démarrage : chaque niveau doit être strictement
# supérieur à celui qu'il contient. LIVE #003 s'est arrêtée sur l'inversion
# exacte — outil 120 s enveloppant un fournisseur borné à 180 s.
ATLAS_PROVIDER_TIMEOUT_MS=180000
ATLAS_TOOL_TIMEOUT_MS=240000
ATLAS_TASK_TIMEOUT_MS=300000
# Dernier filet contre l'enlisement : une succession d'appels légitimes qui
# n'aboutit jamais. 0 désactive.
ATLAS_MISSION_TIMEOUT_MS=900000

# ─── Bornes de recherche web ─────────────────────────────────────────────────
# Chaque recherche et chaque page rapportée entre dans le contexte et y reste
# pour tous les tours suivants : la dépense n'est pas celle de la requête, c'est
# celle du contexte qu'elle laisse derrière elle.
# Le nombre effectif de recherches suit l'objectif : viser 2 candidats en
# déclenche 4, pas 6.
ATLAS_MAX_WEB_SEARCHES_PER_DISCOVERY=6
ATLAS_MAX_PAGE_FETCHES_PER_CANDIDATE=2
ATLAS_MAX_TOTAL_PAGE_FETCHES_PER_MISSION=20

# ─── Moteur de recherche ─────────────────────────────────────────────────────
# Le LLM n'est plus le moteur de recherche d'ATLAS. Un moteur répond en quelques
# centaines de millisecondes parce qu'il ne fait qu'une chose ; LIVE #005 a
# attendu sept minutes qu'un modèle fasse ce travail, trois fois, sans jamais
# l'obtenir — 0,86 $ pour zéro candidat.
#
# Nouvelle chaîne :
#   brief → requêtes courtes → moteur → filtrage déterministe
#         → pages ciblées → analyse par le modèle
# auto (défaut) | duckduckgo | marginalia | searxng | brave | anthropic | none
#
# `auto` enregistre tous les moteurs configurés et laisse le Search Fabric
# router à chaque requête selon l'état réel du parc : adéquation, puis santé,
# puis coût, puis latence et historique mesurés, puis la priorité ci-dessous.
#
# C'est le défaut parce qu'un moteur unique reste un point de défaillance
# unique, quel qu'il soit. DuckDuckGo a bridé, et « attendre quelques heures »
# est devenu la stratégie du système — ce qui n'en est pas une pour quelque
# chose censé tourner 24 h/24. Avec `auto`, un moteur bridé passe en
# refroidissement et un autre prend la file.
#
# Nommer un moteur reste possible et reste utile pour reproduire un incident.
# C'est alors un parc d'un seul moteur, avec ce que cela suppose.
#
# Une mission n'est BLOCKED-BY-SEARCH-FABRIC que lorsque *tous* les moteurs
# adaptés et autorisés sont indisponibles.
ATLAS_SEARCH_PROVIDER=auto

# Adresse de l'instance sur le réseau Docker. Aucun port n'est publié : une
# instance SearXNG exposée publiquement devient un relais ouvert et se fait
# bloquer par les moteurs qu'elle interroge.
SEARXNG_BASE_URL=http://searxng:8080

# Clé aléatoire exigée par SearXNG pour signer ses formulaires.
# Générer : node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SEARXNG_SECRET=change-me

# Moteurs interrogés. Quatre suffisent : chacun ajoute sa latence, ses pannes et
# ses blocages, et SearXNG attend le plus lent avant de fusionner.
# Vide = les moteurs configurés dans deployment/searxng/settings.yml.
SEARXNG_ENGINES=duckduckgo,brave,startpage,mojeek

# --- Gmail (lecture seule d'abord) ----------------------------
# Obtenus par `npm run gmail:authorize` sur un poste avec navigateur (client OAuth
# « Desktop app », flux loopback + PKCE). Le jeton va dans .env.local (ignoré par
# Git) ; sur le VPS, recopiés à la main dans /opt/atlas/.env (chmod 600).
# Portées acceptées : gmail.readonly ; gmail.send seulement avec --with-send ;
# jamais gmail.modify ni mail.google.com. Aucun envoi tant que
# ATLAS_OUTBOUND_ENABLED=false, quel que soit le jeton.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# GMAIL_USER=

# --- Brave Search : OPTIONNEL ---
# Utile seulement si ATLAS_SEARCH_PROVIDER=brave. Laisser vide sous SearXNG.
# La clé ne quitte jamais l'en-tête de la requête : ni journal, ni erreur, ni
# télémétrie.
BRAVE_SEARCH_API_KEY=

# Tarif par requête du forfait Brave, pour une comptabilité honnête.
# Sous SearXNG le coût de recherche vaut 0 et cette valeur est ignorée.
# Le coût moteur reste compté séparément du coût d'inférence : une recherche à
# 0,005 $ et un raisonnement à 0,50 $ ne se pilotent pas de la même manière.
ATLAS_SEARCH_COST_PER_QUERY_USD=0.005

# Repli vers l'ancienne recherche par modèle. Désactivé par construction :
# basculer sans qu'on l'ait demandé multiplierait la dépense par cent.
ATLAS_SEARCH_FALLBACK_ENABLED=false

ATLAS_SEARCH_TIMEOUT_MS=15000
ATLAS_SEARCH_RESULTS_PER_QUERY=10
# Candidats transmis au modèle après filtrage. Pas cent pages : quatre à six
# dossiers déjà identifiés.
ATLAS_SEARCH_MAX_CANDIDATES=6
ATLAS_SEARCH_MAX_CHARS_PER_PAGE=6000

# Plafond de contexte d'une étape de découverte. LIVE #005 a produit un tour à
# 154 000 jetons d'entrée — 0,49 $ pour un seul appel, 57 % de la mission.
ATLAS_DISCOVERY_MAX_CONTEXT_TOKENS=40000

# --- Moteur commercial en production --------------------------
# L'interrupteur général de l'envoi. FAUX au premier déploiement : le serveur
# découvre, qualifie, lit la boîte, mesure — et n'écrit à personne tant qu'une
# personne ne l'a pas levé en connaissance de cause.
ATLAS_OUTBOUND_ENABLED=false
# INTERNAL_TEST ne contacte jamais un vrai prospect, quels que soient les
# autres réglages. PRODUCTION est un choix explicite, à poser avec le précédent.
ATLAS_ENGINE_MODE=INTERNAL_TEST
# La cadence des cycles (boîte, envois approuvés, relances, découverte,
# mesures, recommandations). Faux = aucun cycle automatique.
ATLAS_SALES_ENGINE_ENABLED=true
# --- L'Autopilot : la boucle de contrôle -----------------------------
# Observe, diagnostique, propose, priorise, confie ce qui est sûr aux workers,
# vérifie, apprend. Faux par défaut : `npm run autopilot:once` joue un cycle à
# la main ; vrai = un cycle toutes les ATLAS_AUTOPILOT_CYCLE_MINUTES dans le
# daemon. Il n'envoie, ne paie, ne déploie jamais : ces décisions restent
# WAITING_HUMAN. Les plafonds ci-dessous s'ajoutent aux budgets IA existants.
ATLAS_AUTOPILOT_ENABLED=false
ATLAS_AUTOPILOT_CYCLE_MINUTES=30
ATLAS_AUTOPILOT_MAX_DISPATCH_PER_CYCLE=3
ATLAS_AUTOPILOT_MAX_OPEN_ACTIONS=12
ATLAS_AUTOPILOT_MAX_CYCLE_COST_USD=0.50
# --- Le runner d'ingénierie ------------------------------------------
# embedded : le daemon du serveur sert CLAUDE / CLAUDE_CODE sur le dépôt courant
#            (poste de développement). external : le service `atlas-engineer`
#            (profil `engineering`) les sert sur un clone jetable, et le daemon
#            du serveur les laisse dans la file. Sur le VPS : external.
ATLAS_ENGINEERING_RUNNER=embedded
# Claude Code facturé à l'appel par la clé d'API (mode non interactif, 24/7) —
# choisi explicitement ; sinon le binaire attend une session par abonnement.
# ATLAS_CLAUDE_CODE_USE_API_KEY=true
ATLAS_SALES_DISCOVERY_ENABLED=true
# Budget IA quotidien de la découverte commerciale, et plafond de requêtes.
ATLAS_SALES_DAILY_AI_BUDGET_USD=0.50
ATLAS_SALES_DAILY_SEARCH_BUDGET=200
# Plafonds d'envoi : par jour (ATLAS_SALES_MAX_NEW_OUTREACH_PER_DAY, plus haut),
# par heure, délai minimal entre deux, fenêtre en heure locale, week-end.
ATLAS_SALES_HOURLY_SEND_CAP=3
ATLAS_SALES_MIN_SEND_DELAY_SECONDS=120
ATLAS_SALES_SEND_WINDOW=09:00-17:30
ATLAS_SALES_WEEKEND_ENABLED=false
ATLAS_SALES_TIMEZONE=Europe/Paris
# Une seule relance par entreprise (0 pour aucune).
ATLAS_SALES_MAX_FOLLOWUPS=1
# Pause automatique des envois au-delà de ce taux de rebonds, sur cet échantillon.
ATLAS_SALES_BOUNCE_PAUSE_RATE=0.05
ATLAS_SALES_BOUNCE_MIN_SAMPLE=20

# --- Automation (n8n) ---------------------------------------
ATLAS_N8N_ENABLED=false
ATLAS_N8N_BASE_URL=http://localhost:5678
ATLAS_N8N_API_KEY=
ATLAS_N8N_WEBHOOK_SECRET=

# --- Evolution ----------------------------------------------
# Self-improvement observes always; applying changes requires approval
# unless autonomy is explicitly raised.
ATLAS_EVOLUTION_ENABLED=true
ATLAS_EVOLUTION_AUTONOMY=propose

# --- Runtime ------------------------------------------------
ATLAS_HEARTBEAT_MS=30000
ATLAS_LOG_LEVEL=info
ATLAS_LOG_PRETTY=true
