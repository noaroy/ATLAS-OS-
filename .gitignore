node_modules/
dist/
# Ancré à la racine : sans le « / » initial, ce motif exclut *tout* répertoire
# nommé « data », à n'importe quelle profondeur — et il a silencieusement exclu
# `packages/data/`, soit toute la couche de persistance, du dépôt. La base
# runtime, elle, vit bien à la racine.
/data/
!/data/.gitkeep
.env
.env.*
!.env.example
# Secrets obtenus par un bootstrap local : jeton OAuth Gmail, caches de jetons.
# `.env.*` les couvre déjà ; nommés ici pour que l'intention reste lisible.
.env.local
*.token.json
.gmail-token*
credentials.json
client_secret*.json
*.log
*.tsbuildinfo
.DS_Store
apps/console/dist/
.claude/settings.local.json
graphify-out/
# Journal local du compteur Graphify : mesure de cette machine, pas du dépôt.
.graphify-meter/
# Les livrables produits pour un client : régénérables depuis la base, et
# susceptibles de porter des données commerciales qui n'ont rien à faire dans
# l'historique du dépôt.
/out/
